---
import '../../../styles.css';
import '../../../brand-overrides.css';
import '../../../sprint2-ux.css';
import '../../../sprint4-credibility.css';
import '../../../sprint7-contact.css';
import '../../../hero-redesign.css';
import '../../../mobile.css';

const assetPath = (file: string) => `/${file}`;
const canonicalURL = new URL('/en/', Astro.site);
const polishURL = new URL('/', Astro.site);
const socialImageURL = new URL('/og-image.png', Astro.site);
const pageTitle = 'Korban Development — Full Stack Java & Angular Developer';
const pageDescription = 'Web applications and business systems built with Java, Spring, Angular and microservices.';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#171817" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="pl" href={polishURL} />
    <link rel="alternate" hreflang="en" href={canonicalURL} />
    <link rel="alternate" hreflang="x-default" href={polishURL} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Korban Development" />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImageURL} />
    <link rel="icon" type="image/svg+xml" href={assetPath('favicon.svg')} />
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400;1,500&family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'ProfessionalService', name: 'Korban Development',
      legalName: 'Usługi Informatyczne Wojciech Korban', description: pageDescription,
      email: 'wojciech.korbna@gmail.com', url: canonicalURL.toString(),
      sameAs: ['https://www.linkedin.com/in/wojciech-korban-423430173/', 'https://github.com/WojciechKorban'],
      taxID: '9591789572', identifier: {'@type': 'PropertyValue', propertyID: 'REGON', value: '383531516'},
      address: {'@type': 'PostalAddress', streetAddress: 'Działkowa 37', postalCode: '25-626', addressLocality: 'Kielce', addressCountry: 'PL'},
      areaServed: 'PL', serviceType: ['Full Stack Java Development', 'Angular Development', 'Microservices Architecture']
    })} />
    <header class="site-header" id="top">
      <a class="brand" href="#top" aria-label="Korban Development — home"><img class="brand-mark" src={assetPath('brand-mark.svg')} alt="" aria-hidden="true" /><span>Korban<br /><b>Development</b></span></a>
      <nav class="main-nav" id="main-navigation" aria-label="Main navigation">
        <a href="#about">About</a><a href="#services">Services</a><a href="#technologies">Technologies</a><a href="#process">How I work</a><a href="#investments">Investments</a><a href="#contact" class="nav-cta">Let's talk <span>↗</span></a>
      </nav>
      <a class="language-switch" href="/" lang="pl" hreflang="pl" aria-label="Przełącz na język polski"><strong>PL</strong><i>/</i><span class="is-current">EN</span></a>
      <button class="menu-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="main-navigation"><span></span><span></span></button>
    </header>

    <main id="main-content">
      <section class="hero section-grid" id="start">
        <div class="hero-copy reveal">
          <p class="eyebrow"><span class="eyebrow-dot"></span> FULL STACK JAVA + ANGULAR</p>
          <h1>I build web applications<br /><em>you can rely on.</em></h1>
          <p class="hero-lead">I design and develop business systems with Java, Spring and Angular — from the user interface to microservice architecture.</p>
          <div class="hero-actions"><a class="button button-primary" href="#contact">Discuss your project <span>↗</span></a><a class="button button-ghost" href="#services">View services <span>↓</span></a></div>
        </div>
        <div class="hero-art reveal reveal-delay" aria-label="Application architecture diagram: Angular, Spring API, microservices and database">
          <div class="system-diagram"><div class="diagram-caption"><span>SYSTEM ARCHITECTURE</span><small>ONLINE / READY</small></div><div class="diagram-flow">
            <div class="diagram-node node-angular"><small>FRONTEND</small><strong>Angular</strong><span>Web application</span></div><div class="diagram-arrow" aria-hidden="true"><i></i><b>REST</b></div>
            <div class="diagram-node node-spring"><small>BACKEND</small><strong>Spring API</strong><span>Security · Business logic</span></div><div class="diagram-arrow" aria-hidden="true"><i></i><b>EVENTS</b></div>
            <div class="services-cluster"><div class="diagram-node"><small>SERVICE 01</small><strong>Users</strong></div><div class="diagram-node"><small>SERVICE 02</small><strong>Orders</strong></div><div class="diagram-node"><small>SERVICE 03</small><strong>Data</strong></div></div>
            <div class="diagram-database"><span></span><strong>DATABASE</strong><small>PostgreSQL</small></div>
          </div></div>
        </div>
        <div class="hero-scroll">SCROLL <span>↓</span></div>
      </section>

      <section class="intro section-grid" id="about"><div class="section-kicker"><span>01</span><span>ABOUT</span></div><div class="intro-content reveal"><p class="eyebrow accent">KORBAN DEVELOPMENT</p><h2>A good system starts with <em>the right solution.</em></h2><p>As a Full Stack Developer, I create web applications that combine a clear interface with a solid backend and well-designed architecture.</p><p>I work with Java, Spring and Angular. I help build new products, integrate systems and modernise existing solutions.</p><a class="text-link" href="mailto:wojciech.korbna@gmail.com">Tell me about your project <span>↗</span></a></div><div class="intro-note">CLEAN CODE<br />LASTS LONGER.</div></section>

      <section class="services" id="services"><div class="section-grid services-head"><div class="section-kicker"><span>02</span><span>SERVICES</span></div><div><p class="eyebrow accent">JAVA + ANGULAR</p><h2>From an idea to<br /><em>a working system.</em></h2></div></div><div class="service-list">
        <article class="service-item"><span class="service-number">01</span><h3>Full Stack<br />Java</h3><p>Backend, business logic and REST APIs built with Java and Spring.</p><span class="service-icon">↗</span></article>
        <article class="service-item"><span class="service-number">02</span><h3>Angular<br />Frontend</h3><p>Clear web applications, dashboards and interfaces tailored to their users.</p><span class="service-icon">↗</span></article>
        <article class="service-item"><span class="service-number">03</span><h3>Microservices<br />and integrations</h3><p>Service decomposition, communication and integration with existing solutions.</p><span class="service-icon">↗</span></article>
        <article class="service-item"><span class="service-number">04</span><h3>Business<br />systems</h3><p>Tools aligned with company processes, data and the team's daily work.</p><span class="service-icon">↗</span></article>
        <article class="service-item"><span class="service-number">05</span><h3>Software<br />modernisation</h3><p>Development, refactoring and safe improvement of existing applications.</p><span class="service-icon">↗</span></article>
      </div></section>

      <section class="technology-section section-grid" id="technologies"><div class="section-kicker"><span>03</span><span>TECHNOLOGIES</span></div><div class="technology-content"><p class="eyebrow accent">MY TECHNOLOGY STACK</p><h2>Tools selected for<br /><em>the problem.</em></h2><p>Technology is a means to an end. I choose it according to the system requirements, the team and the product's future development — without unnecessary complexity.</p><div class="technology-groups"><div><span>BACKEND</span><b>Java</b><b>Spring</b><b>REST API</b></div><div><span>FRONTEND</span><b>Angular</b><b>TypeScript</b><b>JavaScript</b></div><div><span>ARCHITECTURE</span><b>Microservices</b><b>Integrations</b><b>Business systems</b></div></div></div></section>

      <section class="projects section-grid" id="process"><div class="section-kicker"><span>04</span><span>HOW I WORK</span></div><div class="projects-content"><p class="eyebrow accent">FROM IDEA TO DEPLOYMENT</p><h2>First I understand<br /><em>the problem.</em> Then I code.</h2><p>Every project starts with understanding its goal, business processes and technical constraints. I then organise the requirements, design the solution and develop it iteratively.</p></div><div class="project-card"><div class="project-visual"><div class="tower tower-one"></div><div class="tower tower-two"></div><div class="tower tower-three"></div><span>ARCHITECTURE<br />API / UI / DATA</span></div><div class="project-meta"><span>01 / DISCOVERY → DELIVERY</span><a href="mailto:wojciech.korbna@gmail.com">LET'S TALK →</a></div></div><div class="process-steps">
        <article><span>01</span><div><h3>Discovery</h3><p>We define the goal, users, constraints and the most important business processes.</p></div></article>
        <article><span>02</span><div><h3>Architecture</h3><p>We choose the system structure, service communication and scope of the first release.</p></div></article>
        <article><span>03</span><div><h3>Implementation</h3><p>I build iteratively, demonstrate progress and respond to feedback.</p></div></article>
        <article><span>04</span><div><h3>Growth</h3><p>After launch, the system can evolve, integrate and improve without starting again.</p></div></article>
      </div></section>

      <section class="quote"><div class="quote-mark">“</div><blockquote>Good code does not end<br />at <em>deployment.</em> That is when<br />it starts working for people.</blockquote><p>— KORBAN DEVELOPMENT</p></section>
      <section class="investment-section section-grid" id="investments"><div class="section-kicker"><span>05</span><span>SECOND DIRECTION</span></div><div class="investment-content"><p class="eyebrow accent">PROPERTY DEVELOPMENT</p><h2>A new field,<br /><em>the same mindset.</em></h2><p>I am also developing a property development business. It is a separate direction for Korban Development, based on long-term thinking, analysis and responsible value creation.</p><span class="investment-status">IN DEVELOPMENT / MORE INFORMATION COMING SOON</span></div></section>

      <section class="contact section-grid" id="contact"><div class="section-kicker"><span>06</span><span>CONTACT</span></div><div class="contact-content"><p class="eyebrow accent">START A CONVERSATION</p><h2>Do you have a system<br /><em>to build?</em></h2><p>Briefly describe what you need. We will discuss the scope, architecture and the best route to a working solution.</p><form class="project-form" id="project-form"><label>Name or company<input name="name" type="text" autocomplete="name" required placeholder="How should I address you?" /></label><label>Email address<input name="email" type="email" autocomplete="email" required placeholder="you@company.com" /></label><label>Project type<select name="projectType" required><option value="" selected disabled>Select an area</option><option>Web application</option><option>Java / Spring backend</option><option>Angular frontend</option><option>Microservices and integrations</option><option>Existing system modernisation</option><option>Other</option></select></label><label>Budget / project stage<select name="budget"><option value="Not specified yet">Not specified yet</option><option>Discovery and estimate</option><option>Prototype / MVP</option><option>Existing system development</option><option>Long-term cooperation</option></select></label><label class="form-full">Briefly describe your needs<textarea name="message" rows="5" required placeholder="What would you like to build or improve?"></textarea></label><button class="button button-accent" type="submit">Prepare email <span>↗</span></button><p class="form-status" id="form-status" role="status" aria-live="polite"></p></form></div><div class="contact-details"><span>CONTACT AND LOCATION</span><a href="mailto:wojciech.korbna@gmail.com">wojciech.korbna@gmail.com</a><div class="social-links" aria-label="Social profiles"><a href="https://www.linkedin.com/in/wojciech-korban-423430173/" target="_blank" rel="noreferrer me">LinkedIn <span>↗</span></a><a href="https://github.com/WojciechKorban" target="_blank" rel="noreferrer me">GitHub <span>↗</span></a></div><small>Company profile and location information:<br /><a href="https://www.gowork.pl/opinie_czytaj,1027436" target="_blank" rel="noreferrer">GoWork.pl ↗</a></small></div></section>

      <section class="company-data" aria-labelledby="company-data-title"><div><p class="eyebrow accent">REGISTRATION DETAILS</p><h2 id="company-data-title">Company information</h2></div><dl>
        <div class="company-name"><dt>Legal name</dt><dd>Usługi Informatyczne Wojciech Korban</dd></div><div><dt>Tax ID (NIP)</dt><dd>9591789572</dd></div><div><dt>REGON</dt><dd>383531516</dd></div><div><dt>Address</dt><dd>Działkowa 37<br />25-626 Kielce, Poland</dd></div><div><dt>Industry</dt><dd>Software and IT systems</dd></div><div><dt>Email</dt><dd><a href="mailto:wojciech.korbna@gmail.com">wojciech.korbna@gmail.com</a></dd></div><div><dt>LinkedIn</dt><dd><a href="https://www.linkedin.com/in/wojciech-korban-423430173/" target="_blank" rel="noreferrer me">Wojciech Korban ↗</a></dd></div><div><dt>GitHub</dt><dd><a href="https://github.com/WojciechKorban" target="_blank" rel="noreferrer me">WojciechKorban ↗</a></dd></div>
      </dl></section>
    </main>

    <a class="mobile-contact-bar" href="#contact" aria-label="Go to the contact form"><span>Have a project?</span><b>Let's talk <i>→</i></b></a>
    <footer class="site-footer"><a class="brand" href="#top"><img class="brand-mark" src={assetPath('brand-mark.svg')} alt="" aria-hidden="true" /><span>Korban<br /><b>Development</b></span></a><span>© <span id="year"></span> Korban Development</span><a href="#top">BACK TO TOP ↑</a></footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const nav = document.querySelector<HTMLElement>('.main-nav');
      if (toggle && nav) {
        const setMenuState = (open: boolean) => { nav.classList.toggle('open', open); document.body.classList.toggle('menu-open', open); toggle.setAttribute('aria-expanded', String(open)); toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu'); };
        toggle.addEventListener('click', () => setMenuState(!nav.classList.contains('open')));
        document.querySelectorAll('.main-nav a').forEach((link) => link.addEventListener('click', () => setMenuState(false)));
        document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && nav.classList.contains('open')) { setMenuState(false); toggle.focus(); } });
      }
      const year = document.querySelector<HTMLElement>('#year');
      if (year) year.textContent = String(new Date().getFullYear());
      const projectForm = document.querySelector<HTMLFormElement>('#project-form');
      const formStatus = document.querySelector<HTMLElement>('#form-status');
      projectForm?.addEventListener('submit', (event) => {
        event.preventDefault(); if (!projectForm.checkValidity()) { projectForm.reportValidity(); return; }
        const data = new FormData(projectForm); const subject = `Project enquiry — ${data.get('projectType')}`;
        const body = [`Name / company: ${data.get('name')}`, `Email: ${data.get('email')}`, `Project type: ${data.get('projectType')}`, `Budget / stage: ${data.get('budget')}`, '', 'Requirements:', data.get('message')].join('\n');
        if (formStatus) formStatus.textContent = 'Opening your email application with a prepared message.';
        window.location.href = `mailto:wojciech.korbna@gmail.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      });
      const mobileContactBar = document.querySelector<HTMLElement>('.mobile-contact-bar'); const hero = document.querySelector<HTMLElement>('.hero'); const contact = document.querySelector<HTMLElement>('#contact');
      if (mobileContactBar && hero && contact && 'IntersectionObserver' in window) {
        let heroVisible = true; let contactVisible = false; const updateContactBar = () => mobileContactBar.classList.toggle('is-visible', !heroVisible && !contactVisible);
        new IntersectionObserver(([entry]) => { heroVisible = entry.isIntersecting; updateContactBar(); }, { threshold: .08 }).observe(hero);
        new IntersectionObserver(([entry]) => { contactVisible = entry.isIntersecting; updateContactBar(); }, { threshold: .05 }).observe(contact);
      }
    </script>
  </body>
</html>
