---
import '../../styles.css';
import '../../brand-overrides.css';
import '../../sprint2-ux.css';
import '../../sprint4-credibility.css';
import '../../sprint7-contact.css';
import '../../hero-redesign.css';
import '../../mobile.css';

const basePath = import.meta.env.BASE_URL;
const assetPath = (file: string) => `${basePath.replace(/\/$/, '')}/${file}`;
const canonicalURL = new URL('/', Astro.site);
const englishURL = new URL('/en/', Astro.site);
const socialImageURL = new URL('/og-image.png', Astro.site);
const pageTitle = 'Korban Development — Full Stack Java & Angular';
const pageDescription = 'Aplikacje webowe i systemy biznesowe w technologiach Java, Spring, Angular i mikroserwisach.';
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#171817" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="pl" href={canonicalURL} />
    <link rel="alternate" hreflang="en" href={englishURL} />
    <link rel="alternate" hreflang="x-default" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Korban Development" />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImageURL} />
    <link rel="icon" type="image/svg+xml" href={assetPath('favicon.svg')} />
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400;1,500&family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Przejdź do treści</a>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'ProfessionalService',
      name: 'Korban Development',
      legalName: 'Usługi Informatyczne Wojciech Korban',
      description: pageDescription,
      email: 'wojciech.korbna@gmail.com',
      url: canonicalURL.toString(),
      sameAs: [
        'https://www.linkedin.com/in/wojciech-korban-423430173/',
        'https://github.com/WojciechKorban'
      ],
      taxID: '9591789572',
      identifier: {
        '@type': 'PropertyValue',
        propertyID: 'REGON',
        value: '383531516'
      },
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Działkowa 37',
        postalCode: '25-626',
        addressLocality: 'Kielce',
        addressCountry: 'PL'
      },
      areaServed: 'PL',
      serviceType: ['Full Stack Java Development', 'Angular Development', 'Microservices Architecture']
    })} />
    <header class="site-header" id="top">
      <a class="brand" href="#top" aria-label="Korban Development — strona główna"><img class="brand-mark" src={assetPath('brand-mark.svg')} alt="" aria-hidden="true" /><span>Korban<br /><b>Development</b></span></a>
      <nav class="main-nav" id="main-navigation" aria-label="Główna nawigacja">
        <a href="#o-nas">O mnie</a><a href="#obszary">Usługi</a><a href="#technologie">Technologie</a><a href="#projekty">Jak pracuję</a><a href="#inwestycje">Inwestycje</a><a href="#kontakt" class="nav-cta">Porozmawiajmy <span>↗</span></a>
      </nav>
      <a class="language-switch" href="/en/" lang="en" hreflang="en" aria-label="English version">EN</a>
      <button class="menu-toggle" aria-label="Otwórz menu" aria-expanded="false" aria-controls="main-navigation"><span></span><span></span></button>
    </header>

    <main id="main-content">
      <section class="hero section-grid" id="start">
        <div class="hero-copy reveal">
          <p class="eyebrow"><span class="eyebrow-dot"></span> FULL STACK JAVA + ANGULAR</p>
          <h1>Tworzę aplikacje webowe,<br /><em>na których można polegać.</em></h1>
          <p class="hero-lead">Projektuję i rozwijam systemy biznesowe w technologiach Java, Spring i Angular — od interfejsu po architekturę mikroserwisową.</p>
          <div class="hero-actions"><a class="button button-primary" href="#kontakt">Porozmawiajmy o projekcie <span>↗</span></a><a class="button button-ghost" href="#obszary">Zobacz usługi <span>↓</span></a></div>
        </div>
        <div class="hero-art reveal reveal-delay" aria-label="Diagram architektury aplikacji: Angular, Spring API, mikroserwisy i baza danych">
          <div class="system-diagram">
            <div class="diagram-caption"><span>ARCHITEKTURA SYSTEMU</span><small>ONLINE / READY</small></div>
            <div class="diagram-flow">
              <div class="diagram-node node-angular"><small>FRONTEND</small><strong>Angular</strong><span>Web application</span></div>
              <div class="diagram-arrow" aria-hidden="true"><i></i><b>REST</b></div>
              <div class="diagram-node node-spring"><small>BACKEND</small><strong>Spring API</strong><span>Security · Business logic</span></div>
              <div class="diagram-arrow" aria-hidden="true"><i></i><b>EVENTS</b></div>
              <div class="services-cluster">
                <div class="diagram-node"><small>SERVICE 01</small><strong>Users</strong></div>
                <div class="diagram-node"><small>SERVICE 02</small><strong>Orders</strong></div>
                <div class="diagram-node"><small>SERVICE 03</small><strong>Data</strong></div>
              </div>
              <div class="diagram-database"><span></span><strong>DATABASE</strong><small>PostgreSQL</small></div>
            </div>
          </div>
        </div>
        <div class="hero-scroll">SCROLL <span>↓</span></div>
      </section>

      <section class="intro section-grid" id="o-nas"><div class="section-kicker"><span>01</span><span>O MNIE</span></div><div class="intro-content reveal"><p class="eyebrow accent">KORBAN DEVELOPMENT</p><h2>Dobry system zaczyna się od <em>dobrego rozwiązania.</em></h2><p>Jako Full Stack Developer tworzę aplikacje webowe, które łączą czytelny interfejs z solidnym backendem i przemyślaną architekturą.</p><p>Pracuję w technologiach Java, Spring i Angular. Pomagam rozwijać nowe produkty, integrować systemy oraz modernizować istniejące rozwiązania.</p><a class="text-link" href="mailto:wojciech.korbna@gmail.com">Napisz o swoim projekcie <span>↗</span></a></div><div class="intro-note">CLEAN CODE<br />LASTS LONGER.</div></section>

      <section class="services" id="obszary"><div class="section-grid services-head"><div class="section-kicker"><span>02</span><span>USŁUGI</span></div><div><p class="eyebrow accent">JAVA + ANGULAR</p><h2>Od pomysłu do<br /><em>działającego systemu.</em></h2></div></div><div class="service-list"><article class="service-item"><span class="service-number">01</span><h3>Full Stack<br />Java</h3><p>Backend, logika biznesowa i REST API w Javie oraz Springu.</p><span class="service-icon">↗</span></article><article class="service-item"><span class="service-number">02</span><h3>Frontend<br />Angular</h3><p>Czytelne aplikacje webowe, panele i interfejsy dopasowane do użytkowników.</p><span class="service-icon">↗</span></article><article class="service-item"><span class="service-number">03</span><h3>Mikroserwisy<br />i integracje</h3><p>Podział systemu, komunikacja usług i łączenie istniejących rozwiązań.</p><span class="service-icon">↗</span></article><article class="service-item"><span class="service-number">04</span><h3>Systemy<br />biznesowe</h3><p>Narzędzia dopasowane do procesów firmy, danych i codziennej pracy zespołu.</p><span class="service-icon">↗</span></article><article class="service-item"><span class="service-number">05</span><h3>Modernizacja<br />oprogramowania</h3><p>Rozwój, refaktoryzacja i bezpieczne porządkowanie istniejących aplikacji.</p><span class="service-icon">↗</span></article></div></section>

      <section class="technology-section section-grid" id="technologie"><div class="section-kicker"><span>03</span><span>TECHNOLOGIE</span></div><div class="technology-content"><p class="eyebrow accent">STACK, KTÓRY ZNAM</p><h2>Narzędzia dopasowane<br />do <em>problemu.</em></h2><p>Technologia jest środkiem do celu. Dobieram ją do wymagań systemu, zespołu i dalszego rozwoju produktu — bez komplikowania rozwiązania na siłę.</p><div class="technology-groups"><div><span>BACKEND</span><b>Java</b><b>Spring</b><b>REST API</b></div><div><span>FRONTEND</span><b>Angular</b><b>TypeScript</b><b>JavaScript</b></div><div><span>ARCHITEKTURA</span><b>Mikroserwisy</b><b>Integracje</b><b>Systemy biznesowe</b></div></div></div></section>

      <section class="projects section-grid" id="projekty"><div class="section-kicker"><span>04</span><span>JAK PRACUJĘ</span></div><div class="projects-content"><p class="eyebrow accent">OD POMYSŁU DO WDROŻENIA</p><h2>Najpierw rozumiem<br /><em>problem.</em> Potem koduję.</h2><p>Każdy projekt zaczynam od poznania celu, procesów biznesowych i ograniczeń technicznych. Następnie porządkuję wymagania, projektuję rozwiązanie i rozwijam je iteracyjnie.</p></div><div class="project-card"><div class="project-visual"><div class="tower tower-one"></div><div class="tower tower-two"></div><div class="tower tower-three"></div><span>ARCHITECTURE<br />API / UI / DATA</span></div><div class="project-meta"><span>01 / ANALIZA → IMPLEMENTACJA</span><a href="mailto:wojciech.korbna@gmail.com">POROZMAWIAJMY →</a></div></div><div class="process-steps"><article><span>01</span><div><h3>Rozpoznanie</h3><p>Porządkujemy cel, użytkowników, ograniczenia i najważniejsze procesy biznesowe.</p></div></article><article><span>02</span><div><h3>Architektura</h3><p>Dobieramy podział systemu, sposób komunikacji usług i zakres pierwszej wersji.</p></div></article><article><span>03</span><div><h3>Implementacja</h3><p>Buduję rozwiązanie iteracyjnie, pokazując postęp i reagując na informację zwrotną.</p></div></article><article><span>04</span><div><h3>Rozwój</h3><p>Po wdrożeniu system można dalej rozwijać, integrować i usprawniać bez zaczynania od zera.</p></div></article></div></section>

      <section class="quote"><div class="quote-mark">“</div><blockquote>Dobry kod nie kończy się<br />na <em>deployu.</em> Zaczyna<br />pracować dla ludzi.</blockquote><p>— KORBAN DEVELOPMENT</p></section>
      <section class="investment-section section-grid" id="inwestycje"><div class="section-kicker"><span>05</span><span>DRUGI KIERUNEK</span></div><div class="investment-content"><p class="eyebrow accent">INWESTYCJE DEWELOPERSKIE</p><h2>Nowy obszar,<br /><em>ten sam sposób myślenia.</em></h2><p>Rozwijam również działalność deweloperską. To osobny kierunek Korban Development — oparty na długoterminowym podejściu, analizie i odpowiedzialnym budowaniu wartości.</p><span class="investment-status">OBSZAR W ROZWOJU / WIĘCEJ INFORMACJI WKRÓTCE</span></div></section>
      <section class="contact section-grid" id="kontakt"><div class="section-kicker"><span>06</span><span>KONTAKT</span></div><div class="contact-content"><p class="eyebrow accent">ZACZNIJMY ROZMOWĘ</p><h2>Masz system<br /><em>do zbudowania?</em></h2><p>Opisz krótko, czego potrzebujesz. Porozmawiamy o zakresie, architekturze i najlepszym sposobie dojścia do działającego rozwiązania.</p><form class="project-form" id="project-form"><label>Imię lub nazwa firmy<input name="name" type="text" autocomplete="name" required placeholder="Jak możemy się do Ciebie zwracać?" /></label><label>Adres e-mail<input name="email" type="email" autocomplete="email" required placeholder="ty@firma.pl" /></label><label>Rodzaj projektu<select name="projectType" required><option value="" selected disabled>Wybierz obszar</option><option>Aplikacja webowa</option><option>Backend Java / Spring</option><option>Frontend Angular</option><option>Mikroserwisy i integracje</option><option>Modernizacja istniejącego systemu</option><option>Inny temat</option></select></label><label>Budżet / etap projektu<select name="budget"><option value="Nie chcę podawać na tym etapie">Nie chcę podawać na tym etapie</option><option>Analiza i wycena</option><option>Prototyp / MVP</option><option>Rozwój istniejącego systemu</option><option>Stała współpraca</option></select></label><label class="form-full">Opisz krótko potrzeby<textarea name="message" rows="5" required placeholder="Co chcesz zbudować lub poprawić?"></textarea></label><button class="button button-accent" type="submit">Przygotuj wiadomość <span>↗</span></button><p class="form-status" id="form-status" role="status" aria-live="polite"></p></form></div><div class="contact-details"><span>KONTAKT I LOKALIZACJA</span><a href="mailto:wojciech.korbna@gmail.com">wojciech.korbna@gmail.com</a><div class="social-links" aria-label="Profile społecznościowe"><a href="https://www.linkedin.com/in/wojciech-korban-423430173/" target="_blank" rel="noreferrer me">LinkedIn <span>↗</span></a><a href="https://github.com/WojciechKorban" target="_blank" rel="noreferrer me">GitHub <span>↗</span></a></div><small>Profil firmy i informacje lokalizacyjne:<br /><a href="https://www.gowork.pl/opinie_czytaj,1027436" target="_blank" rel="noreferrer">GoWork.pl ↗</a></small></div></section>
      <section class="company-data" aria-labelledby="company-data-title">
        <div>
          <p class="eyebrow accent">DANE REJESTROWE</p>
          <h2 id="company-data-title">Informacje o firmie</h2>
        </div>
        <dl>
          <div class="company-name"><dt>Pełna nazwa</dt><dd>Usługi Informatyczne Wojciech Korban</dd></div>
          <div><dt>NIP</dt><dd>9591789572</dd></div>
          <div><dt>REGON</dt><dd>383531516</dd></div>
          <div><dt>Adres</dt><dd>Działkowa 37<br />25-626 Kielce</dd></div>
          <div><dt>Branża</dt><dd>Oprogramowanie i systemy IT</dd></div>
          <div><dt>E-mail</dt><dd><a href="mailto:wojciech.korbna@gmail.com">wojciech.korbna@gmail.com</a></dd></div>
          <div><dt>LinkedIn</dt><dd><a href="https://www.linkedin.com/in/wojciech-korban-423430173/" target="_blank" rel="noreferrer me">Wojciech Korban ↗</a></dd></div>
          <div><dt>GitHub</dt><dd><a href="https://github.com/WojciechKorban" target="_blank" rel="noreferrer me">WojciechKorban ↗</a></dd></div>
        </dl>
      </section>
    </main>

    <a class="mobile-contact-bar" href="#kontakt" aria-label="Przejdź do formularza kontaktowego"><span>Masz projekt?</span><b>Napisz <i>→</i></b></a>

    <footer class="site-footer"><a class="brand" href="#top"><img class="brand-mark" src={assetPath('brand-mark.svg')} alt="" aria-hidden="true" /><span>Korban<br /><b>Development</b></span></a><span>© <span id="year"></span> Korban Development</span><a href="#top">DO GÓRY ↑</a></footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const nav = document.querySelector<HTMLElement>('.main-nav');
      if (toggle && nav) {
        const setMenuState = (open: boolean) => {
          nav.classList.toggle('open', open);
          document.body.classList.toggle('menu-open', open);
          toggle.setAttribute('aria-expanded', String(open));
          toggle.setAttribute('aria-label', open ? 'Zamknij menu' : 'Otwórz menu');
        };
        toggle.addEventListener('click', () => setMenuState(!nav.classList.contains('open')));
        document.querySelectorAll('.main-nav a').forEach((link) => link.addEventListener('click', () => setMenuState(false)));
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && nav.classList.contains('open')) {
            setMenuState(false);
            toggle.focus();
          }
        });
      }
      const year = document.querySelector<HTMLElement>('#year');
      if (year) year.textContent = String(new Date().getFullYear());
      const projectForm = document.querySelector<HTMLFormElement>('#project-form');
      const formStatus = document.querySelector<HTMLElement>('#form-status');
      projectForm?.addEventListener('submit', (event) => {
        event.preventDefault();
        if (!projectForm.checkValidity()) { projectForm.reportValidity(); return; }
        const data = new FormData(projectForm);
        const subject = `Zapytanie projektowe — ${data.get('projectType')}`;
        const body = [`Imię / firma: ${data.get('name')}`, `E-mail: ${data.get('email')}`, `Rodzaj projektu: ${data.get('projectType')}`, `Budżet / etap: ${data.get('budget')}`, '', 'Opis potrzeb:', data.get('message')].join('\n');
        if (formStatus) formStatus.textContent = 'Otwieram program pocztowy z przygotowaną wiadomością.';
        window.location.href = `mailto:wojciech.korbna@gmail.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      });
      const mobileContactBar = document.querySelector<HTMLElement>('.mobile-contact-bar');
      const hero = document.querySelector<HTMLElement>('.hero');
      const contact = document.querySelector<HTMLElement>('#kontakt');
      if (mobileContactBar && hero && contact && 'IntersectionObserver' in window) {
        let heroVisible = true;
        let contactVisible = false;
        const updateContactBar = () => mobileContactBar.classList.toggle('is-visible', !heroVisible && !contactVisible);
        new IntersectionObserver(([entry]) => { heroVisible = entry.isIntersecting; updateContactBar(); }, { threshold: .08 }).observe(hero);
        new IntersectionObserver(([entry]) => { contactVisible = entry.isIntersecting; updateContactBar(); }, { threshold: .05 }).observe(contact);
      }
    </script>
  </body>
</html>
